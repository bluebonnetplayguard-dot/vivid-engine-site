{
  "name": "ContactSubmission",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "service_interest": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "new"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
