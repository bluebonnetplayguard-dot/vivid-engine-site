{
  "name": "AccountDeletionRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed"
      ],
      "default": "pending"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_notified": {
      "type": "boolean",
      "default": false
    },
    "user_notified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "email",
    "status",
    "requested_at",
    "due_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}