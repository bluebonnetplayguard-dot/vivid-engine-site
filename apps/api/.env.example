PORT=3000
# Comma-separated origins allowed to call the API (only needed if the web app is on another domain).
CORS_ORIGINS=http://localhost:5173
# Where contact form messages are sent. Without SMTP settings, messages are logged instead.
CONTACT_TO=
CONTACT_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
