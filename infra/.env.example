# Copy to /opt/vivid/infra/.env on the server and fill in. Never commit the real file. No values here on purpose.
# Secrets: openssl rand -hex 32   (hex only: the database password goes inside a connection URL)

DOMAIN=                      # vividenginesolutions.com
PUBLIC_ORIGIN=               # https://vividenginesolutions.com
LETSENCRYPT_EMAIL=           # certificate expiry notices

# Database (shared by the app and postgres containers)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Auth
JWT_ACCESS_SECRET=           # 32+ bytes hex
JWT_REFRESH_SECRET=          # 32+ bytes hex
PUBLIC_CLIENT_SECRET=        # 32+ bytes hex, visitor proof-of-work and rate-limit hashing
ADMIN_EMAILS=                # comma list; these accounts get the admin role once verified

# Google sign-in (OAuth client, type Web; redirect https://<domain>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email (any SMTP provider)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                   # "Vivid Engine Solutions <info@...>"
STAFF_NOTIFY_EMAIL=

# Square (developer.squareup.com > your app). Webhook: https://<domain>/api/webhooks/square
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=          # payments from any other location are rejected
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENVIRONMENT=          # sandbox until switched to production

# AI providers
ANTHROPIC_API_KEY=           # Claude: reasoning, writing, code, Build Studio planner
PERPLEXITY_API_KEY=          # Perplexity Agent API: web search with citations (default for search)
GEMINI_API_KEY=              # Gemini: images, video, multimodal
CLAUDE_MODEL=                # default claude-opus-5-5
GEMINI_SEARCH_MODEL=         # comma list, best first
PERPLEXITY_SEARCH_MODEL=     # Perplexity Agent API model id
PPLX_GEMINI_MODEL=           # Gemini through the Perplexity Agent API (fallback)
AI_SEARCH_DAILY_BUDGET_USD=  # estimated spend ceiling per UTC day; 0 = none
AI_MONTHLY_CAP_USD=          # hard monthly cap for the credit ledger
AI_MARGIN_MULTIPLIER=        # flags plans priced below this multiple of API cost (default 2.5)

# Text alerts for new leads (Twilio; optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE=

# Market pricing research (optional)
TAVILY_API_KEY=
EXA_API_KEY=

# Vivid Video Studio (optional)
PEXELS_API_KEY=              # stock footage
VIDEO_STORYBOARD_MODEL=      # default claude-haiku-5-5
VIDEO_DAILY_BUDGET_USD=

# Vivid Build Studio (optional). Set GEOMETRY_SERVICE_URL=http://geometry:8090 and run compose with --profile studio.
GEOMETRY_SERVICE_URL=
BUILD_STUDIO_MODEL=          # default claude-sonnet-5-5

# IndexNow (the site serves /<key>.txt)
INDEXNOW_KEY=

# Off-site backups to DigitalOcean Spaces (optional)
SPACES_BUCKET=
SPACES_REGION=
SPACES_KEY=
SPACES_SECRET=
BACKUP_RETENTION_DAYS=
