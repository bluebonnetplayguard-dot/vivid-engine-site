# Copy to /opt/vivid/.env on the Droplet and fill in. Never commit the real file.
# Generate each secret with:  openssl rand -hex 32
# (hex only: the database password is placed inside a connection URL)

PUBLIC_ORIGIN=https://vividenginesolutions.com
DOMAIN=vividenginesolutions.com
LETSENCRYPT_EMAIL=info@vividenginesolutions.com

# Database (used by both the api and postgres containers)
POSTGRES_USER=vivid
POSTGRES_DB=vivid
POSTGRES_PASSWORD=change-me-long-random

# Auth
JWT_ACCESS_SECRET=change-me-48-random-bytes
JWT_REFRESH_SECRET=change-me-48-random-bytes
PUBLIC_CLIENT_SECRET=change-me-48-random-bytes
ADMIN_EMAILS=info@vividenginesolutions.com

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client, type "Web")
# Authorized redirect URI: https://vividenginesolutions.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email (any SMTP provider: Postmark, Resend, Amazon SES, Google Workspace)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vivid Engine Solutions <info@vividenginesolutions.com>"
STAFF_NOTIFY_EMAIL=info@vividenginesolutions.com

# Stripe (Dashboard > Developers). Webhook endpoint: https://vividenginesolutions.com/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         customer.subscription.updated, customer.subscription.deleted  (the last two keep AI Search plans in sync)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Claude (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Text alerts to you for new leads (Twilio). Leave blank to skip; skips are logged in SmsLog.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE=

# Market pricing research providers (each optional; see docs/PRICING.md). Server-side only.
TAVILY_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=

# Vivid AI Search (see docs/AI_SEARCH.md). Claude answers using ANTHROPIC_API_KEY above.
# Each engine below is optional; one without a key is simply left out of answers.
# PERPLEXITY_API_KEY above is shared with this feature.
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-5-mini
GEMINI_API_KEY=
# Comma list, best first: the next model answers if one is retired or over quota.
GEMINI_SEARCH_MODEL=gemini-4-argon,gemini-3.8-flash
# Perplexity Agent API (POST /v1/agent) model ids. With PERPLEXITY_API_KEY alone, Gemini and ChatGPT
# second opinions run through Perplexity, and Claude answers through it when ANTHROPIC_API_KEY is
# missing or failing. Check ids at docs.perplexity.ai/docs/agent-api/models.
PERPLEXITY_SEARCH_MODEL=perplexity/sonar
PPLX_GEMINI_MODEL=google/gemini-3.8-flash
PPLX_OPENAI_MODEL=openai/gpt-6-luna
# Most AI Search may spend per day (estimated, USD). Questions pause until midnight UTC when reached. 0 = no ceiling.
AI_SEARCH_DAILY_BUDGET_USD=25

# Vivid Video Studio (see docs/VIDEO_STUDIO.md). Captions and AI voiceover use OPENAI_API_KEY above;
# script-to-video uses ANTHROPIC_API_KEY, or OpenAI if Claude is unavailable.
# Free stock footage: create a key at pexels.com/api (leave blank to hide stock search).
PEXELS_API_KEY=
VIDEO_TRANSCRIBE_MODEL=whisper-1
VIDEO_TTS_MODEL=gpt-4o-mini-tts
VIDEO_STORYBOARD_MODEL=claude-haiku-5-5
# Most Video Studio AI may spend per day (estimated, USD). AI features pause until midnight UTC when reached.
VIDEO_DAILY_BUDGET_USD=10

# IndexNow (Bing etc.). The site already serves this key file: /a3f7b2c9e1d48560f2c6b8a1d3e5f729.txt
INDEXNOW_KEY=a3f7b2c9e1d48560f2c6b8a1d3e5f729

# Off-site backups to DigitalOcean Spaces (Spaces Object Storage > Access keys)
SPACES_BUCKET=vivid-backups
SPACES_REGION=nyc3
SPACES_KEY=
SPACES_SECRET=
BACKUP_RETENTION_DAYS=30

# Vivid Build Studio (AI design in the search box). Leave blank to keep it off.
# To turn it on: GEOMETRY_SERVICE_URL=http://geometry:8090, then run compose with --profile studio.
GEOMETRY_SERVICE_URL=
BUILD_STUDIO_MODEL=claude-sonnet-5-5
