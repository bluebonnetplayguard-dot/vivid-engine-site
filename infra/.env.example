# Copy to /opt/vivid/infra/.env on the server and fill in. Never commit the real file. No values here on purpose.
# Secrets: openssl rand -hex 32   (hex only: the database password goes inside a connection URL)

# vividenginesolutions.com
DOMAIN=
# https://vividenginesolutions.com
PUBLIC_ORIGIN=
# certificate expiry notices
LETSENCRYPT_EMAIL=

# Database (shared by the app and postgres containers)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Auth
# 32+ bytes hex
JWT_ACCESS_SECRET=
# 32+ bytes hex
JWT_REFRESH_SECRET=
# 32+ bytes hex, visitor proof-of-work and rate-limit hashing
PUBLIC_CLIENT_SECRET=
# comma list; these accounts get the admin role once verified
ADMIN_EMAILS=

# Google sign-in (OAuth client, type Web; redirect https://<domain>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email (any SMTP provider)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# "Vivid Engine Solutions <info@...>"
MAIL_FROM=
STAFF_NOTIFY_EMAIL=

# Square (developer.squareup.com > your app). Webhook: https://<domain>/api/webhooks/square
SQUARE_APPLICATION_ID=
# payments from any other location are rejected
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# sandbox until switched to production
SQUARE_ENVIRONMENT=

# AI providers
# Claude: reasoning, writing, code, Build Studio planner
ANTHROPIC_API_KEY=
# Perplexity Agent API: web search with citations (default for search)
PERPLEXITY_API_KEY=
# Gemini: images, video, multimodal
GEMINI_API_KEY=
# default claude-opus-5-5
CLAUDE_MODEL=
# comma list, best first
GEMINI_SEARCH_MODEL=
# Perplexity Agent API model id
PERPLEXITY_SEARCH_MODEL=
# Gemini through the Perplexity Agent API (fallback)
PPLX_GEMINI_MODEL=
# estimated spend ceiling per UTC day; 0 = none
AI_SEARCH_DAILY_BUDGET_USD=
# hard monthly cap for the credit ledger
AI_MONTHLY_CAP_USD=
# flags plans priced below this multiple of API cost (default 2.5)
AI_MARGIN_MULTIPLIER=

# Saved conversation history is encrypted with this key: openssl rand -base64 32
HISTORY_ENCRYPTION_KEY=
# after rotating, the old key(s), comma separated, so earlier history stays readable
HISTORY_ENCRYPTION_KEY_PREVIOUS=

# Text alerts for new leads (Twilio; optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE=

# Market pricing research (optional)
TAVILY_API_KEY=
EXA_API_KEY=

# Vivid Video Studio (optional)
# stock footage
PEXELS_API_KEY=
# default claude-haiku-5-5
VIDEO_STORYBOARD_MODEL=
VIDEO_DAILY_BUDGET_USD=

# Vivid Build Studio (optional). Set GEOMETRY_SERVICE_URL=http://geometry:8090 and run compose with --profile studio.
GEOMETRY_SERVICE_URL=
# default claude-sonnet-5-5
BUILD_STUDIO_MODEL=

# IndexNow (the site serves /<key>.txt)
INDEXNOW_KEY=

# Off-site backups to DigitalOcean Spaces (optional)
SPACES_BUCKET=
SPACES_REGION=
SPACES_KEY=
SPACES_SECRET=
BACKUP_RETENTION_DAYS=
