{
  "specVersion": "1.0",
  "project": {
    "name": "Half-lap beam crossing",
    "drawnBy": "Vivid Build Studio",
    "revision": "A",
    "description": "Two 4x4 timbers crossing at mid-length, half-lapped flush and through-bolted.",
    "display": {
      "units": "ft-in",
      "fraction": 16
    }
  },
  "parameters": {
    "member_length": "4ft",
    "size": "3-1/2in"
