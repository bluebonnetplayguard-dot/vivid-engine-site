      "id": "bolt-hole",
      "type": "drill",
      "targets": [
        "beam-a",
        "beam-b"
      ],
      "at": [
        "member_length / 2",
        "member_length / 2",
        "size"
      ],
      "axis": "z",
      "diameter": "1/2in",
      "depth": "through",
      "countersink": {
        "diameter": "1-3/8in",
        "angle": 90
      },
      "minEdgeDistance": 1.5
    }
  ]
