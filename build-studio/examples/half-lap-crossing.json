      "name": "Douglas fir #1",
      "kind": "lumber",
      "color": "#c08b52"
    }
  },
  "sections": {
    "4x4": {
      "nominal": "4x4",
      "width": "size",
      "depth": "size"
    }
  },
  "elements": [
    {
      "id": "beam-a",
      "type": "beam",
      "name": "Beam A",
      "material": "df",
      "section": "4x4",
      "length": "member_length",
      "placement": {
        "origin": [
          "0",
          "member_length / 2 - size / 2",
          "0"
        ],
        "rotation": "along-x"
      },
      "attributes": {
        "productionNumber": "A1"
      }
    },
    {
      "id": "beam-b",
      "type": "beam",
      "name": "Beam B",
      "material": "df",
      "section": "4x4",
      "length": "member_length",
      "placement": {
        "origin": [
          "member_length / 2 - size / 2",
          "0",
          "0"
        ],
        "rotation": "along-y"
      },
      "attributes": {
        "productionNumber": "B1"
      }
    }
  ],
  "joints": [
    {
      "id": "lap-1",
      "type": "half-lap",
      "members": [
        "beam-a",
        "beam-b"
      ],
